NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — fine-grained PAT scoped to the tracked repo(s), read-only.
# Never expose this with a NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=

# Server-only — used by the RW-3 proposal validator (/api/proposals/validate).
# Without it, switching a Proposal to "На валидации" returns a clear error
# instead of a verdict; nothing else on the site depends on it.
ANTHROPIC_API_KEY=
# Custom API endpoint base URL (optional; defaults to https://api.anthropic.com if not set)
ANTHROPIC_BASE_URL=
